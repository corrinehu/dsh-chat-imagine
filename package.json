  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "assets",
    "README.md",
    "README.en.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "image",
    "image-generation",
    "chat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corrinehu/dsh-chat-imagine.git"
  },
  "bugs": {
    "url": "https://github.com/corrinehu/dsh-chat-imagine/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
